# yamllint config: relaxed enough for Ansible and k8s manifests, strict on real errors.
extends: relaxed

rules:
  line-length:
    max: 160
    level: warning
  comments:
    min-spaces-from-content: 1
  document-start: disable
  truthy:
    # allow yes/no (Ansible/netplan) as well as true/false
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false

ignore: |
  .github/
